# =============================================================================
# Real Estate Lead Bot — Environment Variables
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# --- Application ---
APP_NAME=Real Estate Lead Bot
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api

# --- Database (PostgreSQL is source of truth) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/real_estate_lead_bot
# Sync URL used by Alembic if needed:
# DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/real_estate_lead_bot

# --- Auth / Security ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
N8N_WEBHOOK_SECRET=change-me-n8n-webhook-secret

# --- CORS / Frontend ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI Provider ---
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30

# --- n8n ---
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# --- Notifications (optional for MVP) ---
# SLACK_WEBHOOK_URL=
# EMAIL_SMTP_HOST=
# EMAIL_FROM=

# --- Observability ---
# SENTRY_DSN=
